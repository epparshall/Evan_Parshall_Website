---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
	<section class="hero">
		<div class="hero-content">
			<div class="hero-text">
				<h1>Hi, I'm Evan Parshall</h1>
				<p>
					I'm a software engineer based in Westfield, Indiana.
				</p>
				<p>
					This is where I share my thoughts, book recommendations, travel experiences, and professional work.
				</p>
			</div>
			<div class="hero-image">
				<img src="/images/evan-parshall.jpg" alt="Evan Parshall" />
			</div>
		</div>
	</section>

	<section class="links">
		<p>Explore my collections:</p>
		<ul>
			<li><a href="/blog">Blog</a> - Thoughts on life.</li>
			<li><a href="/books">Books</a> - Reviews of my favorite books.</li>
			<li><a href="/travel">Travel</a> - Stories and advice from travels.</li>
			<li><a href="/publications">Publications</a> -Professional writing and research.</li>
		</ul>
	</section>

	<section class="connect">
		<p>Connect with me:</p>
		<ul>
			<li><a href="mailto:epparshall.gcp@gmail.com">epparshall.gcp@gmail.com</a></li>
			<li><a href="https://www.linkedin.com/in/evanparshall/" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
			<li><a href="https://github.com/epparshall" target="_blank" rel="noopener noreferrer">GitHub</a></li>
		</ul>
	</section>
</BaseLayout>

<style>
	.hero {
		padding: 2rem 0;
	}

	.hero-content {
		display: flex;
		align-items: center;
		gap: 3rem;
		flex-wrap: wrap-reverse;
	}

	.hero-text {
		flex: 1;
		min-width: 300px;
	}

	.hero-image {
		flex-shrink: 0;
	}

	.hero-image img {
		width: 250px;
		height: 250px;
		object-fit: cover;
		border-radius: 50%;
		box-shadow: 0 4px 20px rgba(0,0,0,0.1);
		border: 4px solid #fff;
	}

	.hero h1 {
		font-size: 3rem;
		margin-bottom: 1rem;
	}

	.hero p {
		font-size: 1.25rem;
		max-width: 60ch;
		line-height: 1.6;
	}

	@media (max-width: 768px) {
		.hero-content {
			flex-direction: column-reverse;
			text-align: center;
			gap: 2rem;
		}

		.hero h1 {
			font-size: 2.25rem;
		}

		.hero p {
			font-size: 1.1rem;
			margin: 0 auto 1rem auto;
		}

		.hero-image img {
			width: 200px;
			height: 200px;
		}
	}

	.links, .connect {
		margin-top: 2rem;
	}

	.links ul, .connect ul {
		list-style: none;
		margin-top: 1rem;
	}

	.links li, .connect li {
		margin-bottom: 0.5rem;
	}
</style>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const destinations = await getCollection('travel');
destinations.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Travel">
	<h1>Travel</h1>
	<p>Time doesn’t pass quickly because it is full, but because it is repetitive. The mind does not measure life in hours, but in differences. Novelty is what anchors memory, and memory is what we mistake for time lived. To travel is to interrupt sameness long enough for life to become legible again.</p>

	<section class="resources-link">
		<a href="/travel/resources">
			<span class="icon">✈️</span>
			<strong>General Tips & Resources</strong>
			<span class="arrow">&rarr;</span>
		</a>
	</section>

	<hr class="section-divider" />

	<ul class="travel-list">
		{destinations.map((dest) => (
			<li class="travel-item">
				<div class="travel-info">
					<a href={`/travel/${dest.id}`}>
						<h2>{dest.data.destination}</h2>
					</a>
					<time class="date" datetime={dest.data.date.toISOString()}>
						{dest.data.date.toLocaleDateString('en-US', {
							year: 'numeric',
							month: 'long',
							timeZone: 'UTC',
						})}
					</time>
					{dest.data.description && <p>{dest.data.description}</p>}
				</div>
			</li>
		))}
	</ul>
</BaseLayout>

<style>
	.travel-list {
		list-style: none;
		margin-top: 2rem;
	}

	.resources-link {
		margin: 2rem 0;
	}

	.resources-link a {
		display: flex;
		align-items: center;
		padding: 1rem 1.5rem;
		background: #f9f9f9;
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		border: 1px solid #eee;
		transition: background 0.2s, border-color 0.2s;
	}

	.resources-link a:hover {
		background: #fff;
		border-color: var(--color-accent);
	}

	.resources-link .icon {
		font-size: 1.5rem;
		margin-right: 1rem;
	}

	.resources-link strong {
		flex: 1;
		font-size: 1.1rem;
	}

	.resources-link .arrow {
		color: var(--color-accent);
		font-weight: bold;
	}

	.section-divider {
		border: 0;
		border-top: 1px solid #eee;
		margin: 3rem 0;
	}

	.travel-item {
		margin-bottom: 3rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid #eee;
	}

	.travel-info {
		flex: 1;
	}

	.travel-info a {
		text-decoration: none;
		color: inherit;
	}

	.travel-info a:hover h2 {
		color: var(--color-accent);
	}

	.travel-item h2 {
		margin-bottom: 0.25rem;
		font-size: 1.75rem;
	}

	.date {
		display: block;
		font-size: 0.9rem;
		color: #666;
		margin-bottom: 0.75rem;
	}

	.read-more {
		display: inline-block;
		margin-top: 1rem;
		color: var(--color-accent) !important;
		font-weight: 500;
	}

	@media (max-width: 600px) {
		.travel-item {
			flex-direction: column;
			gap: 1rem;
		}
		.travel-thumbnail {
			width: 100%;
		}
	}
</style>

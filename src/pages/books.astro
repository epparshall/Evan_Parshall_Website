---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const books = await getCollection('books');
const rankingsEntry = await getEntry('rankings', 'rankings');
const favoriteOrder = rankingsEntry?.data.favoriteBooks || [];

// Sort books based on the ranking list
const sortedBooks = books.sort((a, b) => {
	const indexA = favoriteOrder.indexOf(a.id);
	const indexB = favoriteOrder.indexOf(b.id);
	
	// If both are in the favorites list
	if (indexA !== -1 && indexB !== -1) return indexA - indexB;
	// If only A is in favorites
	if (indexA !== -1) return -1;
	// If only B is in favorites
	if (indexB !== -1) return 1;
	// If neither, sort alphabetically
	return a.data.title.localeCompare(b.data.title);
});

// Create a helper function to get rank
function getBookRank(id: string) {
	const index = favoriteOrder.indexOf(id);
	return index !== -1 ? index + 1 : null;
}
---

<BaseLayout title="Books">
	<h1>Books</h1>
	<p>My favorite books, ranked and reviewed. Click on a book to read my full notes.</p>
	<ul class="book-list">
		{sortedBooks.map((book) => {
			const rank = getBookRank(book.id);
			return (
				<li class="book-item">
					<div class="rank">{rank ? `#${rank}` : '-'}</div>
					<div class="book-info">
						<a href={`/books/${book.id}`}>
							<h2>{book.data.title}</h2>
						</a>
						<p class="author">by {book.data.author}</p>
						<div class="meta">
							<span class="status">{book.data.status}</span>
							{book.data.rating && (
								<span class="rating"> - {book.data.rating}/5 stars</span>
							)}
						</div>
					</div>
				</li>
			);
		})}
	</ul>
</BaseLayout>

<style>
	.book-list {
		list-style: none;
		margin-top: 2rem;
	}

	.book-item {
		display: flex;
		gap: 1.5rem;
		align-items: flex-start;
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid #eee;
	}

	.rank {
		font-size: 1.5rem;
		font-weight: bold;
		color: var(--color-accent);
		min-width: 3rem;
	}

	.book-item h2 {
		margin-bottom: 0.1rem;
		font-size: 1.5rem;
	}

	.book-item a {
		text-decoration: none;
		color: inherit;
	}

	.book-item a:hover h2 {
		color: var(--color-accent);
	}

	.author {
		font-style: italic;
		color: #666;
		margin-bottom: 0.5rem;
	}

	.meta {
		font-size: 0.85rem;
		color: #888;
		text-transform: uppercase;
	}
</style>

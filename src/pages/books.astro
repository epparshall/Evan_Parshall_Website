---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const books = await getCollection('books');

// Robust sorting: items with 'order' come first (ascending), then by title
books.sort((a, b) => {
	const orderA = a.data.order ?? Infinity;
	const orderB = b.data.order ?? Infinity;
	if (orderA !== orderB) return orderA - orderB;
	return a.data.title.localeCompare(b.data.title);
});
---

<BaseLayout title="Books">
	<h1>Books</h1>
	<p>My favorite books, ranked and reviewed. Click on a book to read my full notes.</p>
	<ul class="book-list">
		{books.map((book, index) => (
			<li class="book-item">
				<div class="rank">{book.data.order ? `#${book.data.order}` : `#${index + 1}`}</div>
				<div class="book-info">
					<a href={`/books/${book.id}`}>
						<h2>{book.data.title}</h2>
					</a>
					<p class="author">by {book.data.author}</p>
					<div class="meta">
						<span class="status">{book.data.status}</span>
						{book.data.rating && (
							<span class="rating"> - {book.data.rating}/5 stars</span>
						)}
					</div>
				</div>
			</li>
		))}
	</ul>
</BaseLayout>

<style>
	.book-list {
		list-style: none;
		margin-top: 2rem;
	}

	.book-item {
		display: flex;
		gap: 1.5rem;
		align-items: flex-start;
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid #eee;
	}

	.rank {
		font-size: 1.5rem;
		font-weight: bold;
		color: var(--color-accent);
		min-width: 3rem;
	}

	.book-item h2 {
		margin-bottom: 0.1rem;
		font-size: 1.5rem;
	}

	.book-item a {
		text-decoration: none;
		color: inherit;
	}

	.book-item a:hover h2 {
		color: var(--color-accent);
	}

	.author {
		font-style: italic;
		color: #666;
		margin-bottom: 0.5rem;
	}

	.meta {
		font-size: 0.85rem;
		color: #888;
		text-transform: uppercase;
	}
</style>

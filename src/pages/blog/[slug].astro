---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const blogEntries = await getCollection('blog', ({ data }) => {
		return data.draft !== true;
	});
	return blogEntries.map(entry => ({
		params: { slug: entry.id }, props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title}>
	<article class="blog-post">
		<header>
			<h1>{entry.data.title}</h1>
			<time datetime={entry.data.pubDate.toISOString()}>
				{entry.data.pubDate.toLocaleDateString('en-US', {
					year: 'numeric',
					month: 'long',
					timeZone: 'UTC'
				})}
			</time>
		</header>
		<div class="content">
			<Content />
		</div>
		<footer>
			<a href="/blog">&larr; Back to all posts</a>
		</footer>
	</article>
</BaseLayout>

<style>
	.blog-post h1 {
		margin-bottom: 0.75rem;
		font-size: clamp(2.35rem, 5vw, 3.75rem);
		letter-spacing: 0;
		line-height: 1.1;
	}

	@media (max-width: 600px) {
		.blog-post h1 {
			font-size: 2.25rem;
		}

		.content {
			font-size: 1.1rem;
		}
	}

	.blog-post time {
		display: block;
		font-size: 0.9rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-light);
		margin-bottom: 3rem;
	}

	.content {
		line-height: 1.8;
		font-size: 1.25rem;
		color: var(--color-text);
	}

	.content p {
		margin-bottom: 2rem;
	}

	.content :global(img) {
		display: block !important;
		margin: 4rem auto !important;
		max-width: 100% !important;
		width: auto !important;
		height: auto !important;
		border-radius: var(--radius);
		box-shadow: var(--shadow-md);
	}

	/* Target book covers specifically */
	.content :global(img[alt*="Cover"]),
	.content :global(img[src*="walker_book"]) {
		max-width: 320px !important;
	}

	.content :global(p:has(img)) {
		text-align: center !important;
		width: 100% !important;
	}

	.content :global(p) {
		margin-bottom: 2rem;
		overflow-wrap: break-word;
		word-break: break-word;
		text-align: left;
	}

	/* Captions */
	.content :global(p:has(img) + p:has(> em:only-child)),
	.content :global(p:has(img) + p:has(> i:only-child)) {
		text-align: center !important;
		margin-top: -3rem !important;
		margin-bottom: 4rem !important;
	}

	.content :global(p:has(img) + p > em:only-child),
	.content :global(p:has(img) + p > i:only-child) {
		display: block !important;
		max-width: 600px !important;
		margin: 0 auto !important;
		font-size: 0.9rem;
		color: var(--color-text-light);
		line-height: 1.5;
		font-style: italic;
	}

	.content :global(.callout) {
		background-color: var(--color-accent-soft);
		border-left: 4px solid var(--color-accent);
		padding: 2rem;
		margin: 3rem 0;
		border-radius: 0 var(--radius) var(--radius) 0;
		font-size: 1.15rem;
		line-height: 1.6;
		font-style: italic;
		color: var(--color-text);
	}

	.content :global(.callout a) {
		color: var(--color-accent);
		text-decoration: underline;
		font-weight: 600;
	}

	/* Table Styles */
	.content :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin: 3rem 0;
		font-size: 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		display: block;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	@media (max-width: 600px) {
		.content :global(table) {
			font-size: 0.9rem;
		}

		.content :global(th),
		.content :global(td) {
			padding: 0.75rem;
		}
	}

	.content :global(th) {
		background-color: var(--color-surface-muted);
		color: var(--color-text);
		font-weight: 700;
		text-align: left;
		padding: 1.25rem;
		border-bottom: 2px solid var(--color-border);
	}

	.content :global(td) {
		padding: 1.25rem;
		border-bottom: 1px solid var(--color-border);
		color: var(--color-text-light);
	}

	.content :global(tr:last-child td) {
		border-bottom: none;
	}

	.content :global(tr:nth-child(even)) {
		background-color: rgba(238, 243, 239, 0.45);
	}

	.content :global(tr:hover) {
		background-color: var(--color-accent-soft);
	}

	.content :global(td:nth-child(2)),
	.content :global(td:nth-child(4)),
	.content :global(td:nth-child(5)),
	.content :global(th:nth-child(2)),
	.content :global(th:nth-child(4)),
	.content :global(th:nth-child(5)) {
		text-align: right;
	}

	.blog-post footer {
		margin-top: 6rem;
		padding-top: 3rem;
		border-top: 1px solid var(--color-border);
	}

	.blog-post footer a {
		font-weight: 600;
		color: var(--color-text-light);
		transition: color 0.2s;
	}

	.blog-post footer a:hover {
		color: var(--color-accent);
	}
</style>

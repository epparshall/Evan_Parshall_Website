---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('blog', ({ data }) => {
	return data.draft !== true;
});posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog">
	<header class="page-header">
		<h1>Blog</h1>
		<p class="subtitle">Writing on technology, health and wellness, finance, travel, politics, and ideas worth sharing.</p>
	</header>

	<div class="posts-list">
		{posts.map((post) => (
			<article class="post-card">
				<a href={`/blog/${post.id}`}>
					<time datetime={post.data.pubDate.toISOString()}>
						{post.data.pubDate.toLocaleDateString('en-US', {
							year: 'numeric',
							month: 'long',
							timeZone: 'UTC'
						})}
					</time>
					<h2>{post.data.title}</h2>
					<p>{post.data.description}</p>
					{post.data.tags && post.data.tags.length > 0 && (
						<div class="post-tags">
							{post.data.tags.map((tag) => (
								<span class="tag">{tag}</span>
							))}
						</div>
					)}
					<span class="read-more">Read post &rarr;</span>
				</a>
			</article>
		))}
	</div>
</BaseLayout>

<style>
	.page-header {
		margin-bottom: 4rem;
	}

	.page-header h1 {
		font-size: clamp(2.75rem, 6vw, 4rem);
		margin-bottom: 1rem;
		letter-spacing: 0;
		line-height: 1.08;
	}

	.subtitle {
		font-size: 1.25rem;
		color: var(--color-text-light);
		max-width: 50ch;
	}

	.posts-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.post-card a {
		display: block;
		padding: 2rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		box-shadow: var(--shadow-sm);
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
		color: inherit;
		text-decoration: none;
	}

	.post-card a:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		border-color: rgba(47, 111, 94, 0.45);
		background: var(--color-surface);
		opacity: 1;
	}

	.post-card time {
		display: block;
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-light);
		margin-bottom: 1rem;
	}

	.post-card h2 {
		margin-top: 0;
		font-size: 1.75rem;
		margin-bottom: 1rem;
		color: var(--color-text);
		line-height: 1.3;
	}

	.post-card p {
		font-size: 1.1rem;
		color: var(--color-text-light);
		margin-bottom: 1.5rem;
		line-height: 1.6;
	}

	.read-more {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--color-accent-strong);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.25rem;
		margin-bottom: 0.75rem;
	}

	.tag {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		padding: 0.15rem 0.55rem;
		background-color: var(--color-surface-muted, #f4f7f5);
		color: var(--color-text-light);
		border-radius: 999px;
		border: 1px solid var(--color-border);
	}

	@media (max-width: 600px) {
		.page-header {
			margin-bottom: 1.75rem;
			text-align: left;
		}

		.page-header h1 {
			font-size: 2.3rem;
			margin-bottom: 0.75rem;
		}

		.subtitle {
			font-size: 1rem;
			line-height: 1.45;
			margin-bottom: 0;
		}

		.post-card a {
			padding: 1.15rem;
		}

		.post-card h2 {
			font-size: 1.35rem;
			margin-bottom: 0.65rem;
		}

		.post-card p {
			font-size: 1rem;
			line-height: 1.5;
			margin-bottom: 1rem;
		}

		.post-card time {
			margin-bottom: 0.65rem;
		}

		.post-tags {
			gap: 0.3rem;
			margin-bottom: 0.5rem;
		}

		.tag {
			font-size: 0.65rem;
			padding: 0.1rem 0.45rem;
		}
	}
</style>

---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Evan Parshall - Software Engineer Portfolio" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Evan Parshall</title>
		<script is:inline>
			document.addEventListener('click', (event) => {
				const link = event.target.closest('a');
				if (link && link.href && (link.protocol === 'http:' || link.protocol === 'https:')) {
					const isExternal = link.origin !== window.location.origin;
					if (isExternal) {
						link.target = '_blank';
						if (!link.rel) {
							link.rel = 'noopener noreferrer';
						}
					}
				}
			}, true);
		</script>
	</head>
	<body>
		<header>
			<nav>
				<div class="logo">
					<a href="/">Evan Parshall</a>
				</div>
				<ul class="nav-links">
					<li><a href="/blog">Blog</a></li>
					<li><a href="/books">Books</a></li>
					<li><a href="/travel">Travel</a></li>
					<li><a href="/publications">Publications</a></li>
				</ul>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			<div class="footer-content">
				<p>&copy; {new Date().getFullYear()} Evan Parshall. Built with Astro.</p>
				<p><span class="btc-icon">₿</span> 14TtsUitabwmVtehspNEfao9CMLzGK7p83</p>
				<p><a href="mailto:epparshall@gmail.com">epparshall@gmail.com</a></p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
		--color-bg: #ffffff;
		--color-text: #1a1a1a;
		--color-accent: #0066cc;
		--max-width: 1000px;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		font-family: var(--font-sans);
		line-height: 1.6;
		color: var(--color-text);
		background-color: var(--color-bg);
		padding: 2rem 1rem;
		max-width: var(--max-width);
		margin: 0 auto;
	}

	@media (max-width: 600px) {
		body {
			padding: 1rem;
		}
	}

	header {
		margin-bottom: 3rem;
	}

	@media (max-width: 600px) {
		header {
			margin-bottom: 2rem;
		}
	}

	nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	@media (max-width: 600px) {
		nav {
			flex-direction: column;
			gap: 1.5rem;
			text-align: center;
		}
	}

	.logo a {
		font-size: 1.5rem;
		font-weight: bold;
		text-decoration: none;
		color: var(--color-text);
	}

	.nav-links {
		display: flex;
		list-style: none;
		gap: 1.5rem;
	}

	@media (max-width: 600px) {
		.nav-links {
			gap: 1rem;
			flex-wrap: wrap;
			justify-content: center;
		}
	}

	.nav-links a {
		text-decoration: none;
		color: var(--color-text);
		transition: color 0.2s;
	}

	.nav-links a:hover {
		color: var(--color-accent);
	}

	main {
		min-height: 60vh;
	}

	footer {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid #eee;
		font-size: 0.9rem;
		color: #666;
	}

	.footer-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
	}

	@media (max-width: 600px) {
		.footer-content {
			flex-direction: column;
			text-align: center;
		}
	}

	.footer-content p {
		margin-bottom: 0;
	}

	.btc-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.2rem;
		height: 1.2rem;
		background-color: #F7931A;
		color: white;
		border-radius: 50%;
		font-size: 0.8rem;
		font-weight: bold;
		vertical-align: middle;
		margin-right: 0.2rem;
		line-height: 1;
		padding-bottom: 0.05rem; /* Optical alignment */
	}

	h1, h2, h3 {
		margin-bottom: 1.5rem;
		line-height: 1.2;
	}

	p {
		margin-bottom: 1rem;
	}

	ul, ol {
		margin-bottom: 1rem;
		padding-left: 1.5rem;
	}

	li {
		margin-bottom: 0.5rem;
	}

	a {
		color: var(--color-accent);
	}
</style>
